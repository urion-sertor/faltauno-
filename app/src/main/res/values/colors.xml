<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta sacada del prototipo de Figma (colores medidos en las pantallas exportadas) -->

    <!-- Verde principal: logo, acción principal, iconos y enlaces -->
    <color name="color_primario">#21634F</color>
    <!-- Verde muy claro: botón Oír, casilla de Dominó y elementos seleccionados -->
    <color name="color_primario_claro">#E7F0E7</color>

    <!-- Fondos: crema de la pantalla y blanco de tarjetas y campos -->
    <color name="color_fondo">#FAF7EF</color>
    <color name="color_fondo_tarjeta">#FFFFFF</color>

    <!-- Textos. El secundario es más oscuro que en Figma (#54665E) para leer mejor: 8:1 sobre crema -->
    <color name="color_texto_principal">#233A35</color>
    <color name="color_texto_secundario">#3F4F49</color>
    <color name="color_texto_blanco">#FFFFFF</color>
    <!-- Pistas de los campos ("Ejemplo: 17:00"): más claras que lo escrito para no confundirlas (5,5:1) -->
    <color name="color_texto_pista">#5F6B66</color>

    <!-- Amarillo del logo y de las etiquetas "Falta 1" (siempre con texto oscuro encima) -->
    <color name="color_amarillo">#F4C66A</color>

    <!-- Colores pastel de las casillas de juego (siempre con texto oscuro encima) -->
    <color name="color_pastel_petanca">#F9E5D5</color>
    <color name="color_pastel_domino">#E7F0E7</color>
    <color name="color_pastel_cartas">#EDE7F5</color>
    <color name="color_pastel_todos">#E3EEF3</color>

    <!-- Bordes: suave para tarjetas y más marcado para campos (3,5:1 sobre blanco) -->
    <color name="color_borde">#D9DED2</color>
    <color name="color_borde_campo">#7D8B83</color>

    <!-- Partida llena: gris verdoso con texto blanco (5,5:1) -->
    <color name="color_gris_lleno">#5F6B66</color>
</resources>
