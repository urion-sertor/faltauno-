<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de partida como en Figma: blanca, esquinas redondeadas y borde suave -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/padding_general"
    android:layout_marginVertical="@dimen/padding_pequeno"
    app:cardBackgroundColor="@color/color_fondo_tarjeta"
    app:cardCornerRadius="@dimen/radio_esquinas"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_borde"
    app:strokeWidth="@dimen/borde_fino">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_general">

        <!-- Fila de arriba: "Hoy · 17:00" y etiqueta amarilla "Falta 1" / "Faltan 2" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHoraPartida"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold"
                tools:text="Hoy · 17:00" />

            <!-- Etiqueta de plazas: texto oscuro sobre amarillo (el adaptador la pone verde claro si está completa) -->
            <TextView
                android:id="@+id/tvPlazasLibres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_pequeno"
                android:background="@drawable/fondo_etiqueta"
                android:paddingHorizontal="@dimen/espacio_icono"
                android:paddingVertical="@dimen/espacio_minimo"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/texto_base"
                android:textStyle="bold"
                tools:text="Falta 1" />
        </LinearLayout>

        <!-- Juego, lugar y quién organiza -->
        <TextView
            android:id="@+id/tvNombreJuego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_pequeno"
            android:textColor="@color/color_primario"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold"
            tools:text="Dominó" />

        <TextView
            android:id="@+id/tvLugarPartida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_minimo"
            android:textColor="@color/color_texto_principal"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold"
            tools:text="Plaza Mayor" />

        <TextView
            android:id="@+id/tvCreadorPartida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_minimo"
            android:textColor="@color/color_texto_secundario"
            android:textSize="@dimen/texto_base"
            tools:text="Organiza Manolo" />

        <!-- Botonera accesible inferior: altavoz TTS y boton de apuntarse -->
        <!-- Botones rellenos y grandes a propósito para personas mayores (no "sin borde" como sugiere lint) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_general"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <!-- Botón "Oír" verde claro con icono de altavoz, como el "Escuchar" de Figma (mínimo 60dp) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAltavoz"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/btn_min_tamano"
                android:layout_marginEnd="@dimen/padding_general"
                android:minWidth="@dimen/btn_min_tamano"
                android:backgroundTint="@color/color_primario_claro"
                android:contentDescription="@string/desc_altavoz"
                android:stateListAnimator="@null"
                android:text="@string/accion_oir"
                android:textColor="@color/color_primario"
                android:textSize="@dimen/texto_subtitulo"
                app:icon="@drawable/ic_altavoz"
                app:iconPadding="@dimen/padding_pequeno"
                app:iconSize="@dimen/tamano_icono_pequeno"
                app:iconTint="@color/color_primario" />

            <!-- Botón principal verde oscuro para unirse (cambia de color/estado desde el Adapter) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMeApunto"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_min_tamano"
                android:layout_weight="1"
                android:backgroundTint="@color/color_primario"
                android:text="@string/accion_me_apunto"
                android:textColor="@color/color_texto_blanco"
                android:textSize="@dimen/texto_subtitulo" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
