<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margen_tarjeta"
    android:layout_marginVertical="@dimen/padding_pequeno"
    app:cardBackgroundColor="@color/color_fondo_tarjeta"
    app:cardCornerRadius="@dimen/radio_esquinas"
    app:cardElevation="@dimen/elevacion_tarjeta"
    app:cardPreventCornerOverlap="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_general">

        <!-- Fila de arriba: Titulo del juego y contador de plazas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNombreJuego"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dominó"
                android:textColor="@color/color_primario"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold" />

            <!-- Etiqueta con las plazas libres -->
            <TextView
                android:id="@+id/tvPlazasLibres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/color_fondo"
                android:paddingHorizontal="@dimen/padding_pequeno"
                android:paddingVertical="4dp"
                android:text="Plazas libres: 1"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/texto_base"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Informacion del evento: hora, lugar y quien creo el aviso -->
        <TextView
            android:id="@+id/tvHoraPartida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Hora: 17:00"
            android:textColor="@color/color_texto_principal"
            android:textSize="@dimen/texto_base" />

        <TextView
            android:id="@+id/tvLugarPartida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lugar: Plaza Mayor"
            android:textColor="@color/color_texto_principal"
            android:textSize="@dimen/texto_base" />

        <TextView
            android:id="@+id/tvCreadorPartida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Avisa: Manolo"
            android:textColor="@color/color_texto_secundario"
            android:textSize="16sp" />

        <!-- Botonera accesible inferior: altavoz TTS y boton de apuntarse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_general"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Boton de lectura por voz (minimo 60dp para mayores) -->
            <Button
                android:id="@+id/btnAltavoz"
                android:layout_width="@dimen/btn_min_tamano"
                android:layout_height="@dimen/btn_min_tamano"
                android:layout_marginEnd="@dimen/padding_general"
                android:backgroundTint="@color/color_azul_altavoz"
                android:contentDescription="@string/desc_altavoz"
                android:text="🔊"
                android:textColor="@color/color_texto_blanco"
                android:textSize="22sp" />

            <!-- Boton principal para unirse (cambia de color/estado desde el Adapter) -->
            <Button
                android:id="@+id/btnMeApunto"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_min_tamano"
                android:layout_weight="1"
                android:backgroundTint="@color/color_verde_apunto"
                android:text="@string/accion_me_apunto"
                android:textColor="@color/color_texto_blanco"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>