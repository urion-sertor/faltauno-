<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de los campos del formulario como en Figma: blanco con borde, y verde claro con borde verde al escribir -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primario_claro" />
            <stroke
                android:width="@dimen/borde_normal"
                android:color="@color/color_primario" />
            <corners android:radius="@dimen/radio_boton" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_fondo_tarjeta" />
            <stroke
                android:width="@dimen/borde_normal"
                android:color="@color/color_borde_campo" />
            <corners android:radius="@dimen/radio_boton" />
        </shape>
    </item>

</selector>
