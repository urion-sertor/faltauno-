<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.MainActivity">

    <!-- Cabecera con el logo "1" amarillo y "Falta Uno!" en verde (igual en todas las pantallas) -->
    <include layout="@layout/cabecera_logo" />

    <!-- Título y explicación de la pantalla -->
    <TextView
        android:id="@+id/tvTituloCabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        android:text="@string/titulo_pantalla_principal"
        android:textColor="@color/color_texto_principal"
        android:textSize="@dimen/texto_grande"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtituloCabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_minimo"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        android:text="@string/subtitulo_pantalla_principal"
        android:textColor="@color/color_texto_secundario"
        android:textSize="@dimen/texto_base" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_general"
        android:paddingStart="@dimen/padding_general"
        android:paddingEnd="@dimen/padding_general"
        android:text="@string/etiqueta_a_que_jugamos"
        android:textColor="@color/color_texto_principal"
        android:textSize="@dimen/texto_subtitulo"
        android:textStyle="bold" />

    <!-- Casillas de colores con icono para filtrar por juego (como en Figma), en una fila desplazable -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/padding_general"
        android:paddingTop="@dimen/padding_pequeno"
        android:paddingEnd="@dimen/padding_general"
        android:paddingBottom="@dimen/padding_pequeno"
        android:scrollbars="none">

        <!-- Botones rellenos y grandes a propósito para personas mayores (no "sin borde" como sugiere lint) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroTodos"
                android:layout_width="@dimen/ancho_casilla"
                android:layout_height="@dimen/alto_casilla"
                android:layout_marginEnd="@dimen/padding_pequeno"
                android:backgroundTint="@color/color_pastel_todos"
                android:stateListAnimator="@null"
                android:text="@string/juego_todos"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/texto_base"
                app:cornerRadius="@dimen/radio_esquinas"
                app:icon="@drawable/ic_juego_todos"
                app:iconGravity="top"
                app:iconSize="@dimen/tamano_icono"
                app:iconTint="@color/color_primario"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="@dimen/borde_fino" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroPetanca"
                android:layout_width="@dimen/ancho_casilla"
                android:layout_height="@dimen/alto_casilla"
                android:layout_marginEnd="@dimen/padding_pequeno"
                android:backgroundTint="@color/color_pastel_petanca"
                android:stateListAnimator="@null"
                android:text="@string/juego_petanca"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/texto_base"
                app:cornerRadius="@dimen/radio_esquinas"
                app:icon="@drawable/ic_juego_petanca"
                app:iconGravity="top"
                app:iconSize="@dimen/tamano_icono"
                app:iconTint="@color/color_primario"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="@dimen/borde_fino" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroDomino"
                android:layout_width="@dimen/ancho_casilla"
                android:layout_height="@dimen/alto_casilla"
                android:layout_marginEnd="@dimen/padding_pequeno"
                android:backgroundTint="@color/color_pastel_domino"
                android:stateListAnimator="@null"
                android:text="@string/juego_domino"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/texto_base"
                app:cornerRadius="@dimen/radio_esquinas"
                app:icon="@drawable/ic_juego_domino"
                app:iconGravity="top"
                app:iconSize="@dimen/tamano_icono"
                app:iconTint="@color/color_primario"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="@dimen/borde_fino" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroCartas"
                android:layout_width="@dimen/ancho_casilla"
                android:layout_height="@dimen/alto_casilla"
                android:layout_marginEnd="@dimen/padding_pequeno"
                android:backgroundTint="@color/color_pastel_cartas"
                android:stateListAnimator="@null"
                android:text="@string/juego_cartas"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/texto_base"
                app:cornerRadius="@dimen/radio_esquinas"
                app:icon="@drawable/ic_juego_cartas"
                app:iconGravity="top"
                app:iconSize="@dimen/tamano_icono"
                app:iconTint="@color/color_primario"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="@dimen/borde_fino" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroParchis"
                android:layout_width="@dimen/ancho_casilla"
                android:layout_height="@dimen/alto_casilla"
                android:backgroundTint="@color/color_amarillo"
                android:stateListAnimator="@null"
                android:text="@string/juego_parchis"
                android:textColor="@color/color_texto_principal"
                android:textSize="@dimen/texto_base"
                app:cornerRadius="@dimen/radio_esquinas"
                app:icon="@drawable/ic_juego_parchis"
                app:iconGravity="top"
                app:iconSize="@dimen/tamano_icono"
                app:iconTint="@color/color_primario"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="@dimen/borde_fino" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Contenedor central con la lista de partidas o aviso cuando no hay resultados -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Lista de partidas del barrio -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPartidas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/padding_pequeno"
            android:paddingBottom="@dimen/padding_pequeno" />

        <!-- Mensaje accesible cuando no hay partidas para el juego seleccionado -->
        <TextView
            android:id="@+id/tvSinPartidas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/padding_grande"
            android:text="@string/mensaje_sin_partidas"
            android:textColor="@color/color_texto_secundario"
            android:textSize="@dimen/texto_subtitulo"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Botón 'Falta 1 · Crear partida' fijo abajo: blanco con borde verde como en Figma -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_fondo_tarjeta"
        android:elevation="@dimen/elevacion_tarjeta"
        android:padding="@dimen/padding_general">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFaltaUno"
            style="@style/Widget.FaltaUno.Boton.Contorno"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_min_tamano"
            android:contentDescription="@string/desc_boton_falta_uno"
            android:text="@string/accion_falta_uno"
            android:textSize="@dimen/texto_subtitulo"
            app:icon="@drawable/ic_mas"
            app:iconGravity="textStart"
            app:iconSize="@dimen/tamano_icono_pequeno" />

    </LinearLayout>

</LinearLayout>
