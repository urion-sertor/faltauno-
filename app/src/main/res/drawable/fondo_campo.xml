<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo común de los campos del formulario: blanco con borde gris, y borde azul cuando se está escribiendo -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_fondo_tarjeta" />
            <stroke
                android:width="3dp"
                android:color="@color/color_primario" />
            <corners android:radius="@dimen/padding_pequeno" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_fondo_tarjeta" />
            <stroke
                android:width="2dp"
                android:color="@color/color_borde" />
            <corners android:radius="@dimen/padding_pequeno" />
        </shape>
    </item>

</selector>
